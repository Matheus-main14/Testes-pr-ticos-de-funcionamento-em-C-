/*
    Exemplo de uso de classes abstratas, interfaces e polimorfismo em C#.


using System;


// ============================================================
// CLASSE ABSTRATA
// ============================================================

abstract class ClasseBase
{
    // PROPRIEDADES
    public string Propriedade1 { get; set; }
    public string Propriedade2 { get; set; }


    // MÉTODO ABSTRATO
    // A classe filha será OBRIGADA a implementar.
    public abstract void MetodoAbstrato();


    // MÉTODO VIRTUAL
    // A classe filha PODE sobrescrever.
    public virtual void MetodoVirtual()
    {
        // implementação padrão
    }


    // MÉTODO CONCRETO
    // A classe filha herda pronto.
    public void MetodoConcreto()
    {
        // implementação
    }
}


// ============================================================
// INTERFACE
// ============================================================

interface IPrimeiraInterface
{
    void MetodoDaInterface();
}


// ============================================================
// OUTRA INTERFACE
// ============================================================

interface ISegundaInterface
{
    void OutroMetodo();
}


// ============================================================
// CLASSE FILHA
// ============================================================

class ClasseFilha : ClasseBase, IPrimeiraInterface, ISegundaInterface
{
    // IMPLEMENTAÇÃO DO MÉTODO ABSTRATO
    public override void MetodoAbstrato()
    {
        // código específico da classe filha
    }


    // SOBRESCRITA DO MÉTODO VIRTUAL
    public override void MetodoVirtual()
    {
        // código específico da classe filha
    }


    // IMPLEMENTAÇÃO DA PRIMEIRA INTERFACE
    public void MetodoDaInterface()
    {
        // implementação
    }


    // IMPLEMENTAÇÃO DA SEGUNDA INTERFACE
    public void OutroMetodo()
    {
        // implementação
    }
}


// ============================================================
// OUTRA CLASSE FILHA
// ============================================================

class OutraClasseFilha : ClasseBase
{
    public override void MetodoAbstrato()
    {
        // implementação diferente
    }


    public override void MetodoVirtual()
    {
        // implementação diferente
    }
}


// ============================================================
// MÉTODO QUE RECEBE A CLASSE BASE
// ============================================================

static void MetodoPolimorfico(ClasseBase objeto)
{
    // Pode receber qualquer classe que herde de ClasseBase.

    objeto.MetodoAbstrato();
    objeto.MetodoVirtual();
    objeto.MetodoConcreto();
}


// ============================================================
// PROGRAMA PRINCIPAL
// ============================================================

class Program
{
    static void Main()
    {
        // CRIAR OBJETOS
        ClasseFilha objeto1 = new ClasseFilha();
        OutraClasseFilha objeto2 = new OutraClasseFilha();


        // POLIMORFISMO
        ClasseBase base1 = objeto1;
        ClasseBase base2 = objeto2;


        // TESTAR
        base1.MetodoAbstrato();
        base1.MetodoVirtual();

        base2.MetodoAbstrato();
        base2.MetodoVirtual();


        // MÉTODO POLIMÓRFICO
        MetodoPolimorfico(objeto1);
        MetodoPolimorfico(objeto2);


        // TESTAR INTERFACE
        objeto1.MetodoDaInterface();
        objeto1.OutroMetodo();
    }
}

*/